# LLM API 配置（硅基流动，默认）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# 切换到 DeepSeek（取消注释并填入真实 key）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-reasoner

# 手动覆盖（不依赖 provider，直接指定，优先级最高）
# LLM_API_KEY=sk-any-key
# LLM_BASE_URL=https://any-endpoint/v1
# LLM_MODEL=any-model-name

# 飞书机器人配置
FEISHU_APP_ID=cli_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
